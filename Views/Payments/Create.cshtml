@model SchoolPortal.Models.Payment

@{
    ViewData["Title"] = "Make Payment";
}

<div class="payment-bg">
    <div class="container d-flex justify-content-center">
        <div class="card shadow-lg border-0 rounded-4 col-md-6">
            <div class="card-body p-4">

                <h4 class="mb-4 text-center fw-bold">Make Payment</h4>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Student</label>

                        @if (User.IsInRole("Admin") || User.IsInRole("Bursar"))
                        {
                            <select asp-for="StudentId"
                                    class="form-control"
                                    asp-items="@((SelectList)ViewData["StudentId"])">
                                <option value="">-- Select student --</option>
                            </select>
                            <span asp-validation-for="StudentId" class="text-danger"></span>
                        }
                        else
                        {
                            <input class="form-control" value="@ViewBag.StudentName" readonly />
                            <input type="hidden" asp-for="StudentId" />
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <input asp-for="Amount" class="form-control" />
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DatePaid" class="form-label"></label>
                        <input asp-for="DatePaid" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Purpose" class="form-label"></label>
                        <input asp-for="Purpose" class="form-control" />
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                        <button type="submit" class="btn btn-primary px-4">Pay Now</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
