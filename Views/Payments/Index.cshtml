@model IEnumerable<SchoolPortal.Models.Payment>

@{
    ViewData["Title"] = "Payments";
    var isBursarOrAdmin = User.IsInRole("Bursar") || User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Payments</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i> New Payment
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>

                <th>Admission No.</th>
                <th>Amount</th>
                <th>Purpose</th>
                <th>Date</th>
                <th>Receipt</th>
                <th>Status</th>
                @if (isBursarOrAdmin)
                {
                    <th>Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Student?.FullName</td>
                    <td>₦@p.Amount.ToString("N2")</td>
                    <td>@(p.Purpose?.ToString() ?? "–")</td>
                    <td>@p.DatePaid.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(p.ReceiptPath))
                        {
                            <a href="@p.ReceiptPath" target="_blank" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-file-earmark me-1"></i>View
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">–</span>
                        }
                    </td>
                    <td>
                        @if (p.Status == SchoolPortal.Models.PaymentStatus.Approved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Initiated</span>
                        }
                    </td>
                    @if (isBursarOrAdmin)
                    {
                        <td class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@p.Id"
                               class="btn btn-outline-info btn-sm">Details</a>

                            @if (p.Status == SchoolPortal.Models.PaymentStatus.Initiated)
                            {
                                <form asp-action="Approve" asp-route-id="@p.Id"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Approve this payment and update student balance?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="bi bi-check2-circle me-1"></i>Approve
                                    </button>
                                </form>
                            }

                            <a asp-action="Delete" asp-route-id="@p.Id"
                               class="btn btn-outline-danger btn-sm">Delete</a>
                        </td>
                    }
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No payments found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
