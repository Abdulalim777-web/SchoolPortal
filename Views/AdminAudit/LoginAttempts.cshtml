@model IEnumerable<SchoolPortal.Models.AuditEntryViewModel>

<h2>Audit Timeline</h2>

<div class="mb-3 d-flex gap-2">
    <a asp-action="LoginAttempts" class="btn btn-outline-primary">Refresh</a>
    <form asp-action="ClearNonUsers" method="post" onsubmit="return confirm('Clear audit entries that are not associated with any user? This cannot be undone.');">
        <button type="submit" class="btn btn-danger">Clear non-users</button>
        @Html.AntiForgeryToken()
    </form>
    <form asp-action="ClearAllLoginAttempts" method="post" onsubmit="return confirm('Clear ALL login attempt entries? This cannot be undone.');">
        <button type="submit" class="btn btn-danger">Clear all login attempts</button>
        @Html.AntiForgeryToken()
    </form>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Time</th>
            <th>User</th>
            <th>Action</th>
            <th>URL</th>
            <th>Reason</th>
            <th>IP</th>
            <th>User Agent</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var entry in Model)
{
    <tr class="@(entry.ActionType.Contains("Failed") || entry.ActionType.Contains("Denied") ? "table-danger" : "")">
        <td>@entry.EventAt.ToLocalTime()</td>
        <td>@(string.IsNullOrEmpty(entry.Email) ? "(anonymous)" : entry.Email)</td>
        <td>@entry.ActionType</td>
        <td>@(entry.Url ?? "-")</td>
        <td>@(entry.Reason ?? "-")</td>
        <td>@(entry.IpAddress ?? "-")</td>
        <td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@(entry.UserAgent ?? "-")</td>
        <td>
            <div class="small text-muted">Source: @(entry.Source ?? "-") | Id: @(entry.Id?.ToString() ?? "-")</div>
            @* Only login audit rows can be deleted individually *@
            @if (entry.Source == "LoginAudit" && entry.Id.HasValue)
            {
                <form asp-action="DeleteLoginAttempt" method="post" style="display:inline;" onsubmit="return confirm('Delete this login attempt? This cannot be undone.');">
                    <input type="hidden" name="id" value="@entry.Id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Delete</button>
                </form>
                @* Show hint for old entries *@
                @if (entry.EventAt < DateTime.UtcNow.AddDays(-30))
                {
                    <span class="badge bg-warning ms-2">Old - consider deleting</span>
                }
            }
            else
            {
                <span class="text-muted">-</span>
            }
        </td>
    </tr>
}
    </tbody>
</table>
