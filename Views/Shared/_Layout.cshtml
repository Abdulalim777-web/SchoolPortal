<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolPortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css"    asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css"    asp-append-version="true" />
</head>
<body>

@{
    string IsActive(string controller) =>
        ViewContext.RouteData.Values["controller"]?.ToString() == controller ? "active" : "";

    bool isAuthPage =
        ViewContext.RouteData.Values["controller"]?.ToString() is "Account";
}

<!-- ══════════════════════════════════════════
     TOP NAVBAR
═══════════════════════════════════════════ -->
<header class="sp-navbar">
    <nav class="navbar navbar-expand-lg navbar-dark px-3">
        <div class="container-fluid">

            <!-- Hamburger (mobile) -->
            <button class="btn sp-hamburger d-md-none me-2"
                    id="sidebarToggle"
                    title="Toggle navigation">
                <i class="fa fa-bars"></i>
            </button>

            <!-- Brand -->
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="fa fa-school me-2"></i>SchoolPortal
            </a>

            <!-- Right: user dropdown -->
            <ul class="navbar-nav ms-auto d-flex align-items-center gap-2">
                @if (!User.Identity!.IsAuthenticated)
                {
                    <a href="/Account/Register" class="btn btn-light btn-sm fw-semibold">Enroll Now</a>
                }

                @using Microsoft.AspNetCore.Identity
                @inject UserManager<User> UserManager
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    var roles       = await UserManager.GetRolesAsync(currentUser!);

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                           href="#" data-bs-toggle="dropdown">
                            <div class="sp-avatar">
                                @(currentUser!.FullName?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div class="text-start d-none d-lg-block">
                                <div class="fw-semibold small lh-sm">@currentUser!.FullName</div>
                                <div class="text-white-50" style="font-size:0.72rem">@roles.FirstOrDefault()</div>
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                    <i class="fa fa-user me-2 text-primary"></i>Profile
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="dropdown-item text-danger">
                                        <i class="fa fa-sign-out-alt me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
            </ul>
        </div>
    </nav>

    <!-- Flash messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-0 mb-0" role="alert">
            <div class="container-fluid"><i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-0 mb-0" role="alert">
            <div class="container-fluid"><i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
</header>

<!-- ══════════════════════════════════════════
     BODY: SIDEBAR + MAIN
═══════════════════════════════════════════ -->
<div class="sp-shell">

    <!-- ── SIDEBAR ─────────────────────────── -->
    @if (User.Identity!.IsAuthenticated)
    {
        <aside id="sidebar" class="sp-sidebar d-none d-md-flex">

            <!-- School badge at top -->
            <div class="sp-sidebar-brand">
                <div class="sp-sidebar-logo">
                    <i class="fa fa-graduation-cap"></i>
                </div>
                <div>
                    <div class="sp-sidebar-school">SchoolPortal</div>
                    <div class="sp-sidebar-session">2024 / 2025</div>
                </div>
            </div>

            <nav class="sp-sidebar-nav">

                <!-- Home – always visible -->
                <a class="sp-nav-link @IsActive("Home")"
                   asp-controller="Home" asp-action="Index">
                    <span class="sp-nav-icon"><i class="fa fa-home"></i></span>
                    <span>Home</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <div class="sp-nav-label">Main</div>

                    <a class="sp-nav-link @IsActive("Dashboard")"
                       asp-controller="Dashboard" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-tachometer-alt"></i></span>
                        <span>Dashboard</span>
                    </a>

                    <div class="sp-nav-label">Management</div>

                    <a class="sp-nav-link @IsActive("AdminUsers")"
                       asp-controller="AdminUsers" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-users-cog"></i></span>
                        <span>Manage Users</span>
                    </a>
                    <a class="sp-nav-link @IsActive("Students")"
                       asp-controller="Students" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-user-graduate"></i></span>
                        <span>Students</span>
                    </a>
                    <a class="sp-nav-link @IsActive("Staff")"
                       asp-controller="Staff" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-chalkboard-teacher"></i></span>
                        <span>Staff</span>
                    </a>

                    <div class="sp-nav-label">Finance</div>

                    <a class="sp-nav-link @IsActive("Payments")"
                       asp-controller="Payments" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-wallet"></i></span>
                        <span>Payments</span>
                    </a>
                    <a class="sp-nav-link @IsActive("Salaries")"
                       asp-controller="Salaries" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-money-bill-wave"></i></span>
                        <span>Salaries</span>
                    </a>
                    <a class="sp-nav-link @IsActive("Expenses")"
                       asp-controller="Expenses" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-file-invoice-dollar"></i></span>
                        <span>Expenses</span>
                    </a>

                    <div class="sp-nav-label">Audit</div>

                    <a class="sp-nav-link @IsActive("AdminAudit")"
                       asp-controller="AdminAudit" asp-action="LoginAttempts">
                        <span class="sp-nav-icon"><i class="fa fa-history"></i></span>
                        <span>Login Audit</span>
                    </a>
                }

                @if (User.IsInRole("Bursar"))
                {
                    <div class="sp-nav-label">Main</div>

                    <a class="sp-nav-link @IsActive("Dashboard")"
                       asp-controller="Dashboard" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-tachometer-alt"></i></span>
                        <span>Dashboard</span>
                    </a>

                    <div class="sp-nav-label">Finance</div>

                    <a class="sp-nav-link @IsActive("Payments")"
                       asp-controller="Payments" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-wallet"></i></span>
                        <span>Payments</span>
                    </a>
                    <a class="sp-nav-link @IsActive("Salaries")"
                       asp-controller="Salaries" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-money-bill-wave"></i></span>
                        <span>Salaries</span>
                    </a>
                    <a class="sp-nav-link @IsActive("Expenses")"
                       asp-controller="Expenses" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-file-invoice-dollar"></i></span>
                        <span>Expenses</span>
                    </a>

                    <div class="sp-nav-label">People</div>

                    <a class="sp-nav-link @IsActive("Students")"
                       asp-controller="Students" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-user-graduate"></i></span>
                        <span>Students</span>
                    </a>
                    <a class="sp-nav-link @IsActive("Staff")"
                       asp-controller="Staff" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-chalkboard-teacher"></i></span>
                        <span>Staff</span>
                    </a>
                }

                @if (User.IsInRole("Teacher"))
                {
                    <div class="sp-nav-label">Main</div>

                    <a class="sp-nav-link @IsActive("Dashboard")"
                       asp-controller="Dashboard" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-tachometer-alt"></i></span>
                        <span>Dashboard</span>
                    </a>
                    <a class="sp-nav-link @IsActive("Students")"
                       asp-controller="Students" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-user-graduate"></i></span>
                        <span>Students</span>
                    </a>
                }

                @if (User.IsInRole("Student"))
                {
                    <div class="sp-nav-label">Main</div>

                    <a class="sp-nav-link @IsActive("Dashboard")"
                       asp-controller="Dashboard" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-tachometer-alt"></i></span>
                        <span>Dashboard</span>
                    </a>
                    
                    <div class="sp-nav-label">My Account</div>

                    <a class="sp-nav-link @IsActive("Payments")"
                       asp-controller="Payments" asp-action="Index">
                        <span class="sp-nav-icon"><i class="fa fa-file-invoice-dollar"></i></span>
                        <span>My Payments</span>
                    </a>
                }

            </nav>

            <!-- Spacer pushes logout down -->
            <div class="sp-sidebar-spacer"></div>

            <!-- Profile card at bottom -->
            @{
                var me    = await UserManager.GetUserAsync(User);
                var myRole = (await UserManager.GetRolesAsync(me!)).FirstOrDefault() ?? "User";
            }
            <div class="sp-sidebar-footer">
                <div class="sp-sidebar-user">
                    <div class="sp-avatar sm">
                        @(me!.FullName?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div class="sp-sidebar-user-info">
                        <div class="sp-sidebar-user-name">@me!.FullName</div>
                        <div class="sp-sidebar-user-role">@myRole</div>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button class="sp-nav-link danger w-100 border-0 bg-transparent text-start">
                        <span class="sp-nav-icon"><i class="fa fa-sign-out-alt"></i></span>
                        <span>Logout</span>
                    </button>
                </form>
            </div>

        </aside>
    }

    <!-- ── MAIN CONTENT ────────────────────── -->
    <main class="sp-main @(User.Identity!.IsAuthenticated ? "" : "sp-main-full")">
        @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Payments")
        {
            <div class="payment-bg">
                @RenderBody()
            </div>
        }
        else
        {
            <div class="sp-content">
                @RenderBody()
            </div>
        }
    </main>

</div>

<!-- ══════════════════════════════════════════
     FOOTER
═══════════════════════════════════════════ -->
<footer class="sp-footer">
    &copy; 2025 SchoolPortal &nbsp;·&nbsp;
    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Mobile sidebar toggle
    document.getElementById('sidebarToggle')?.addEventListener('click', () => {
        document.getElementById('sidebar')?.classList.toggle('open');
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
