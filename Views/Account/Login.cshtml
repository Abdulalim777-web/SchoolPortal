@model SchoolPortal.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        background: #eef4ff;
    }
    .login-card {
        max-width: 420px;
        margin: 70px auto;
        background: #fff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }
    .login-card h5 {
        font-weight: 600;
    }
</style>

<div class="login-card">
    <div class="text-center mb-3">
        <i class="fa fa-user-circle fa-3x text-primary"></i>
    </div>
    <h5 class="text-center mb-4">Have an account?</h5>

    <div class="container mt-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
</div>


    <form asp-action="Login" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3 input-group">
            <span class="input-group-text bg-white"><i class="fa fa-envelope text-muted"></i></span>
            <input asp-for="Email" class="form-control" placeholder="Email" />
        </div>
        <span asp-validation-for="Email" class="text-danger"></span>

        <div class="input-group mb-2">
            <span class="input-group-text bg-white"><i class="fa fa-lock text-muted"></i></span>
            <input asp-for="Password"
                type="password"
                class="form-control"
                id="loginPassword"
                placeholder="Password" />
            <button type="button" class="btn btn-outline-secondary" style="border-top-left-radius:0;border-bottom-left-radius:0" onclick="toggleLoginPassword()">
                <i class="fa fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    
    

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">
                    Remember me
                </label>
            </div>
            <a href="#" class="small">Forgot password?</a>
        </div>

        <button type="submit"
                class="btn btn-primary w-100"
                id="loginBtn">
            <i class="fa fa-sign-in-alt me-2"></i>
            <span id="loginText">Sign in</span>
            <span id="loginSpinner"
                  class="spinner-border spinner-border-sm d-none"
                  role="status"
                  aria-hidden="true"></span>
        </button>
    </form>
    <hr/>

<div class="text-center">
    <form asp-controller="Account" asp-action="ExternalLogin" method="post">
        <input type="hidden" name="provider" value="Google" />
        <button type="submit" class="btn btn-outline-danger w-100">
            <img src="https://developers.google.com/identity/images/g-logo.png"
                 style="height:20px; margin-right:8px;" />
            Continue with Google
        </button>
    </form>
</div>



    <div class="text-center mt-3">
        Don’t have an account?
        <a asp-action="Register">Create account</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    const form = document.querySelector("form");
    const btn = document.getElementById("loginBtn");
    const text = document.getElementById("loginText");
    const spinner = document.getElementById("loginSpinner");

    form.addEventListener("submit", function () {
        btn.disabled = true;
        text.textContent = "Signing in...";
        spinner.classList.remove("d-none");
    });
</script>
