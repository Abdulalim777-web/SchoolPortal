@model SchoolPortal.Models.Staff
@{
    ViewData["Title"] = "Delete Staff";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-left"></i>
    </a>
    <div>
        <h4 class="fw-bold mb-0 text-danger">Delete Staff Member</h4>
        <small class="text-muted">This action cannot be undone</small>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">

        <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 mb-4">
            <i class="fa fa-exclamation-triangle fa-lg"></i>
            <div>Are you sure you want to permanently delete <strong>@Model.FullName</strong>?</div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                    <div class="sp-avatar" style="width:46px;height:46px;font-size:1.1rem;background:rgba(239,68,68,0.1);color:#dc2626;border:none">
                        @(Model.FullName?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                    <div>
                        <div class="fw-bold">@Model.FullName</div>
                        <span class="badge bg-danger-subtle text-danger">@(Model.Position ?? "Staff")</span>
                    </div>
                </div>

                <ul class="list-unstyled mb-0 small">
                    <li class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Email</span>
                        <span>@(Model.Email ?? "—")</span>
                    </li>
                    <li class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Phone</span>
                        <span>@(Model.PhoneNumber ?? "—")</span>
                    </li>
                    <li class="d-flex justify-content-between py-1">
                        <span class="text-muted">Date Joined</span>
                        <span>@Model.DateJoined.ToString("dd MMM yyyy")</span>
                    </li>
                </ul>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="fa fa-trash me-1"></i> Yes, Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>

    </div>
</div>
