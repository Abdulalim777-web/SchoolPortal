@model SchoolPortal.Models.Staff
@{
    ViewData["Title"] = "Staff Details";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-left"></i>
    </a>
    <div>
        <h4 class="fw-bold mb-0">Staff Details</h4>
        <small class="text-muted">Viewing profile for @Model.FullName</small>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">

                {{-- Avatar + name header --}}
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="sp-avatar" style="width:52px;height:52px;font-size:1.3rem;background:rgba(37,99,235,0.12);color:#1d4ed8;border:none">
                        @(Model.FullName?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                    <div>
                        <div class="fw-bold fs-5">@Model.FullName</div>
                        <span class="badge bg-primary-subtle text-primary">@(Model.Position ?? "Staff")</span>
                    </div>
                </div>

                <ul class="list-unstyled mb-0">
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="fa fa-briefcase me-2"></i>Position</span>
                        <span class="fw-semibold">@(Model.Position ?? "—")</span>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="fa fa-calendar me-2"></i>Date Joined</span>
                        <span class="fw-semibold">@Model.DateJoined.ToString("dd MMMM yyyy")</span>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="fa fa-envelope me-2"></i>Email</span>
                        <span class="fw-semibold">@(Model.Email ?? "—")</span>
                    </li>
                    <li class="d-flex justify-content-between py-2">
                        <span class="text-muted"><i class="fa fa-phone me-2"></i>Phone</span>
                        <span class="fw-semibold">@(Model.PhoneNumber ?? "—")</span>
                    </li>
                </ul>

                <div class="d-flex gap-2 mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                        <i class="fa fa-pen me-1"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                        <i class="fa fa-trash me-1"></i> Delete
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-auto">
                        <i class="fa fa-list me-1"></i> Back to List
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
