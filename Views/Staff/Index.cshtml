@model IEnumerable<SchoolPortal.Models.Staff>
@{
    ViewData["Title"] = "Staff";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Staff</h4>
        <small class="text-muted">All staff members</small>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="fa fa-plus me-1"></i> Add Staff
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Position</th>
                        <th>Date Joined</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="sp-avatar sm" style="background:rgba(37,99,235,0.12);color:#1d4ed8;border:none;font-size:0.8rem">
                                        @(s.FullName?.Substring(0, 1).ToUpper() ?? "?")
                                    </div>
                                    <span class="fw-semibold">@s.FullName</span>
                                </div>
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary">@(s.Position ?? "—")</span></td>
                            <td>@s.DateJoined.ToString("dd MMM yyyy")</td>
                            <td class="text-muted small">@(s.Email ?? "—")</td>
                            <td class="text-muted small">@(s.PhoneNumber ?? "—")</td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@s.Id"
                                       class="btn btn-outline-info btn-sm" title="Details">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@s.Id"
                                       class="btn btn-outline-warning btn-sm" title="Edit">
                                        <i class="fa fa-pen"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@s.Id"
                                       class="btn btn-outline-danger btn-sm" title="Delete">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="fa fa-chalkboard-teacher fa-2x mb-2 d-block opacity-25"></i>
                                No staff records yet.
                                <a asp-action="Create">Add the first one.</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
