@model SchoolPortal.Models.Student
@{
    ViewData["Title"] = "Student Details";
    var isAdminOrBursar = User.IsInRole("Admin") || User.IsInRole("Bursar");
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-left"></i>
    </a>
    <div>
        <h4 class="fw-bold mb-0">Student Details</h4>
        <small class="text-muted">Full profile for @Model.FullName</small>
    </div>
</div>

<div class="row g-3">


    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">

                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="sp-avatar"
                         style="width:54px;height:54px;font-size:1.3rem;background:rgba(99,102,241,0.12);color:#4f46e5;border:none;flex-shrink:0">
                        @(Model.FullName?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                    <div>
                        <div class="fw-bold fs-5 lh-sm">@Model.FullName</div>
                        <span class="badge mt-1"
                              style="background:rgba(99,102,241,0.12);color:#4f46e5">
                            @(Model.Class ?? "No class assigned")
                        </span>
                    </div>
                </div>

                <ul class="list-unstyled mb-0">
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted"><i class="fa fa-chalkboard me-2"></i>Class</span>
                        <span class="fw-semibold">@(Model.Class ?? "—")</span>
                    </li>

                    @if (isAdminOrBursar)
                    {
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted"><i class="fa fa-wallet me-2"></i>Balance</span>
                            <span class="fw-semibold @(Model.Balance < 0 ? "text-danger" : "text-success")">
                                ₦@Model.Balance.ToString("N2")
                            </span>
                        </li>
                    }

                    <li class="d-flex justify-content-between py-2">
                        <span class="text-muted"><i class="fa fa-id-badge me-2"></i>Student ID</span>
                        <span class="fw-semibold text-muted">#@Model.Id</span>
                    </li>
                </ul>

                @if (isAdminOrBursar && Model.Balance < 0)
                {
                    <div class="alert alert-danger py-2 small mt-3 mb-0 rounded-3">
                        <i class="fa fa-exclamation-triangle me-1"></i>
                        Outstanding balance of <strong>₦@Math.Abs(Model.Balance).ToString("N2")</strong>
                    </div>
                }

            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            @if (isAdminOrBursar)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                    <i class="fa fa-pen me-1"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                    <i class="fa fa-trash me-1"></i> Delete
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-auto">
                <i class="fa fa-list me-1"></i> Back to List
            </a>
        </div>
    </div>


    @if (Model.Payments != null && Model.Payments.Any())
    {
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-3">Recent Payments</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Purpose</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Payments.OrderByDescending(p => p.DatePaid).Take(10))
                                {
                                    <tr>
                                        <td class="small">@p.DatePaid.ToString("dd MMM yyyy")</td>
                                        <td class="small">@(p.Purpose?.ToString() ?? "—")</td>
                                        <td class="fw-semibold small">₦@p.Amount.ToString("N0")</td>
                                        <td>
                                            @if (p.Status == SchoolPortal.Models.PaymentStatus.Approved)
                                            {
                                                <span class="badge bg-success">Approved</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Initiated</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

</div>
