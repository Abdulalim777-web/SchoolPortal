@model IEnumerable<SchoolPortal.Models.Student>
@{
    ViewData["Title"] = "Students";
    var isAdminOrBursar = User.IsInRole("Admin") || User.IsInRole("Bursar");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Students</h4>
        <small class="text-muted">@Model.Count() student(s) enrolled</small>
    </div>
    @if (isAdminOrBursar)
    {
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa fa-plus me-1"></i> Add Student
        </a>
    }
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Student</th>
                        <th>Class</th>
                        @if (isAdminOrBursar)
                        {
                            <th>Balance</th>
                        }
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="sp-avatar sm"
                                         style="background:rgba(99,102,241,0.12);color:#4f46e5;border:none;font-size:0.78rem;flex-shrink:0">
                                        @(item.FullName?.Substring(0, 1).ToUpper() ?? "?")
                                    </div>
                                    <span class="fw-semibold">@item.FullName</span>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Class))
                                {
                                    <span class="badge bg-indigo-subtle text-indigo"
                                          style="background:rgba(99,102,241,0.1);color:#4f46e5">
                                        @item.Class
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            @if (isAdminOrBursar)
                            {
                                <td>
                                    <span class="fw-semibold @(item.Balance < 0 ? "text-danger" : "text-success")">
                                        ₦@item.Balance.ToString("N0")
                                    </span>
                                </td>
                            }
                            <td class="text-end pe-4">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-outline-info btn-sm" title="View Details">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    @if (isAdminOrBursar)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-warning btn-sm" title="Edit">
                                            <i class="fa fa-pen"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm" title="Delete">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(isAdminOrBursar ? 4 : 3)"
                                class="text-center text-muted py-5">
                                <i class="fa fa-user-graduate fa-2x mb-2 d-block opacity-25"></i>
                                No students enrolled yet.
                                @if (isAdminOrBursar)
                                {
                                    <a asp-action="Create">Add the first student.</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
