@model SchoolPortal.Models.Student
@{
    ViewData["Title"] = "Add Student";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-left"></i>
    </a>
    <div>
        <h4 class="fw-bold mb-0">Add Student</h4>
        <small class="text-muted">Fill in the student details below</small>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fa fa-user text-muted"></i>
                            </span>
                            <input asp-for="FullName" class="form-control" placeholder="Student's full name" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Class" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fa fa-chalkboard text-muted"></i>
                            </span>
                            <select asp-for="Class" class="form-select">
                                <option value="">— Select class —</option>
                                <option value="JSS 1">JSS 1</option>
                                <option value="JSS 2">JSS 2</option>
                                <option value="JSS 3">JSS 3</option>
                                <option value="SS 1">SS 1</option>
                                <option value="SS 2">SS 2</option>
                                <option value="SS 3">SS 3</option>
                            </select>
                        </div>
                        <span asp-validation-for="Class" class="text-danger small"></span>
                    </div>

                   
                    <input type="hidden" asp-for="Balance" value="0" />

                    <div class="alert alert-info py-2 small mb-4">
                        <i class="fa fa-info-circle me-1"></i>
                        Student balance starts at <strong>₦0</strong> and is managed by the bursar.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-1"></i> Save Student
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
